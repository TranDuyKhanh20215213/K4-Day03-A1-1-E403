flowchart TD
    %% 🌟 SƠ ĐỒ HYBRID FLOWCHART ARCHITECTURE (ĐỀ TÀI 10: TRỢ LÝ TÌM & ĐẶT LỊCH XEM NHÀ TRỌ)
    
    A["👤 User Input - Câu hỏi từ người dùng"] --> B{"🧠 Intent Classifier / Router"}

    %% 🟢 ROUTE 1: SIMPLE CHATBOT PATH WITH CHATBOT_BASELINE_PROMPT
    B -- "Câu hỏi Đơn giản" --> C["💬 Chatbot Baseline Path"]
    
    subgraph ChatbotPath ["📄 Chatbot Baseline Execution Path"]
        C --> C1["📜 Prompt: CHATBOT_BASELINE_PROMPT<br/>- Trả lời thắc mắc chung<br/>- Không sử dụng Tool"]
        C1 --> C2["🤖 LLM Provider Direct Generation<br/>- Sinh câu trả lời trực tiếp từ kiến thức LLM"]
    end
    
    C2 --> Z["🏁 Final Output - Phản hồi gửi người dùng"]

    %% 🟡 ROUTE 2: REACT AGENT PATH WITH REACT_SYSTEM_PROMPT
    B -- "Câu hỏi phức tạp" --> D["🤖 ReAct Agent Path"]
    
    subgraph ReActPath ["🔄 ReAct Agent Loop & Safeguards"]
        D --> D1["📜 Prompt: REACT_SYSTEM_PROMPT<br/>- Ép cấu trúc Thought -> Action -> Observation<br/>- Quy tắc thu thập thông tin khi thiếu<br/>- Cấu hình Phanh An Toàn Guardrails"]
        D1 --> E["🧠 Thought: Suy luận logic, phân tích câu hỏi & chọn Tool"]
        E --> F{"🛠️ Check Tool Specs & Call Tool"}
        
        F -- "1. Tra cứu phòng trọ" --> G["Action: search_apartments[location, max_price]"]
        F -- "2. Kiểm tra lịch chủ nhà" --> H["Action: check_landlord_schedule[room_id, date]"]
        F -- "3. Đặt lịch xem phòng" --> I["Action: book_viewing_appointment[room_id, date_time, customer_name, phone]"]
        
        G --> O["👁️ Observation: Kết quả thật từ Tool hoặc System Error"]
        H --> O
        I --> O
        
        O --> J{"🛡️ Guardrails Check<br/>MAX_ITERATIONS = 4"}
        
        J -- "Còn bước cần xử lý" --> E
        J -- "Thành công / Đủ thông tin" --> K["Thought: Đã đủ thông tin<br/>Final Answer: Trả lời kết quả cuối cùng"]
        J -- "Chưa đủ thông tin / Lỗi mã phòng / Vượt bước" --> L["🛡️ Safe Fallback / Hỏi lại người dùng"]
    end

    K --> Z
    L --> Z
    
    %% Styles
    style A fill:#f9f9f9,stroke:#333,stroke-width:2px
    style B fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style C fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style C1 fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    style D fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style D1 fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style J fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Z fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
